{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "<id>/index.json, one game's public releases (docs/SPEC.md section 5)",
  "type": "object",
  "required": ["format", "id", "name", "game", "appid", "releases"],
  "properties": {
    "format": { "const": 1 },
    "id": { "$ref": "common.defs.json#/$defs/id" },
    "name": { "$ref": "common.defs.json#/$defs/text" },
    "game": { "$ref": "common.defs.json#/$defs/text" },
    "appid": { "$ref": "common.defs.json#/$defs/appid" },
    "description": { "$ref": "common.defs.json#/$defs/text" },
    "releases": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "release-entry.schema.json" },
          { "required": ["url"], "properties": { "maturity": { "$ref": "common.defs.json#/$defs/listedMaturity" } } }
        ]
      }
    },
    "knownIssues": { "$ref": "common.defs.json#/$defs/knownIssues" },
    "data": {
      "type": "object",
      "description": "The game's data zip (SPEC section 11): readers check its size and SHA-256.",
      "required": ["url", "sha256", "size", "date"],
      "properties": {
        "url": { "$ref": "common.defs.json#/$defs/url" },
        "sha256": { "$ref": "common.defs.json#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "date": { "$ref": "common.defs.json#/$defs/date" }
      }
    }
  }
}
