{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.defs.json",
  "title": "Shared definitions (docs/SPEC.md section 2)",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$", "description": "Plain dotted numbers, never a pre-release form." },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "url": { "type": "string", "pattern": "^(https://[^\\s/]+|http://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?(/|$))[^\\s]*$", "description": "https, or plain http to localhost / 127.0.0.1 only." },
    "appid": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1, "description": "Plain text for people: never HTML or Markdown." },
    "buildId": { "type": "string", "pattern": "^[0-9]+$" },
    "buildIds": { "type": "array", "items": { "$ref": "#/$defs/buildId" } },
    "maturity": { "enum": ["closed-beta", "open-beta", "stable"] },
    "listedMaturity": { "enum": ["open-beta", "stable"] },
    "status": { "enum": ["stable", "open-beta", "coming"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "loader": {
      "type": "object",
      "required": ["type", "version"],
      "properties": { "type": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" } }
    },
    "source": {
      "type": "object",
      "description": "The receipt: what the release was built from.",
      "required": ["commit", "actionsCommit", "builtAt"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "coreRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "The core's repository, owner/name." },
        "coreCommit": { "$ref": "#/$defs/commit" },
        "coreFrom": { "type": "string", "pattern": "^tag v[0-9]+(\\.[0-9]+)*$" },
        "actionsCommit": { "$ref": "#/$defs/commit" },
        "builtAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "knownIssue": {
      "type": "object",
      "required": ["id", "title", "text", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["minor", "annoying", "blocking"] },
        "since": { "$ref": "#/$defs/version" },
        "fixedIn": { "anyOf": [{ "$ref": "#/$defs/version" }, { "type": "null" }] }
      }
    }
  }
}
